// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CLIENT
}

enum EventType {
  WEDDING
  QUINCEANOS
  BAUTIZO
  COMUNION
}

enum UserPlan {
  BASIC
  PRO
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(CLIENT)

  plan UserPlan @default(BASIC)
  active    Boolean  @default(true)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Template {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  type         EventType
  description  String?
  previewImage String?
  active       Boolean   @default(true)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id String @id @default(cuid())

  name      String
  slug      String    @unique
  type      EventType
  eventDate DateTime
  expiresAt DateTime?

  userId     String
  templateId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  details   EventDetails?
  locations EventLocation[]
  schedules EventSchedule[]
  photos    EventPhoto[]
  music     EventMusic?
  guests EventGuest[]
  message EventMessage?
  theme EventTheme?
  gifts EventGift[]

  backgroundEnabled   Boolean @default(false)
  backgroundTexture   String?
  backgroundOpacity   Float   @default(0.15)
  backgroundPosition  String  @default("center")

  @@index([userId])
  @@index([templateId])
}

model EventDetails {
  id      String @id @default(cuid())
  eventId String @unique

  title       String?
  subtitle    String?
  description String?
  phrase      String?
  dressCode   String?

  groomName       String?
  brideName       String?
  quinceaneraName String?
  childName       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventLocation {
  id        String  @id @default(cuid())
  eventId   String
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  mapsUrl   String?

  createdAt DateTime @default(now())

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schedules EventSchedule[]

  @@index([eventId])
}

model EventSchedule {
  id      String @id @default(cuid())
  eventId String

  title       String
  date        DateTime
  time        String?
  description String?
  locationId  String?

  createdAt DateTime @default(now())

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location EventLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([locationId])
}

model EventPhoto {
  id      String @id @default(cuid())
  eventId String

  url      String
  publicId String?
  title    String?
  order    Int     @default(0)
  isCover Boolean @default(false)

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventMusic {
  id      String @id @default(cuid())
  eventId String @unique

  url      String
  title    String?
  artist   String?
  autoplay Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum GuestStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model EventGuest {
  id        String   @id @default(cuid())

  eventId   String

  name      String
  phone     String?
  email     String?

  passes    Int      @default(1)
  confirmed Int?

  status    GuestStatus @default(PENDING)

  token     String   @unique @default(cuid())

  message   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
}

model EventMessage {
  id        String   @id @default(cuid())
  eventId   String   @unique
  content   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId],references: [id],onDelete: Cascade)
}

model EventTheme {
  id        String @id @default(cuid())

  eventId   String @unique
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  preset    String @default("ELEGANT")

  primaryColor   String @default("#292524")
  secondaryColor String @default("#78716c")
  accentColor    String @default("#a8a29e")
  backgroundColor String @default("#fafaf9")
  surfaceColor   String @default("#ffffff")
  textColor      String @default("#292524")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GiftType {
  ENVELOPE
  PHYSICAL_GIFT
  GIFT_TABLE
  BANK_TRANSFER
  CUSTOM
}

model EventGift {
  id            String   @id @default(cuid())
  eventId       String

  type          GiftType
  title         String
  description   String?
  url           String?

  accountName   String?
  accountNumber String?

  order         Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}